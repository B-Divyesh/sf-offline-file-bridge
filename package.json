{
  "name": "offline-file-bridge",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build && node scripts/clean-test-preview.mjs 4173 && playwright test",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:android": "cd android && ./gradlew test",
    "test:android-device": "cd android && ./gradlew connectedReleaseAndroidTest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "8.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@playwright/test": "1.58.2",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
